<?xml version="1.0" encoding="utf-8"?>
<!-- Avant-plan de l'icône : un graphe de conversations en cercle (motif
     Etherman/Appman) — anneau guide, 5 nœuds, arêtes colorées qui se croisent.
     Dessiné dans la zone sûre (centre 54,54, rayon 24). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anneau guide (pointillé impossible en vector simple : trait fin discret). -->
    <path
        android:strokeColor="#232A38"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M54,30 a24,24 0 1,0 0.01,0 z" />

    <!-- Arêtes qui traversent le cercle (couleurs = protocoles). -->
    <path android:strokeColor="#4C9BE8" android:strokeWidth="2.4"
        android:pathData="M54,30 L68.1,73.4" />
    <path android:strokeColor="#F39C12" android:strokeWidth="2.4"
        android:pathData="M54,30 L39.9,73.4" />
    <path android:strokeColor="#27AE60" android:strokeWidth="2.4"
        android:pathData="M76.8,46.6 L39.9,73.4" />
    <path android:strokeColor="#1ABC9C" android:strokeWidth="2.4"
        android:pathData="M76.8,46.6 L31.2,46.6" />
    <path android:strokeColor="#E74C3C" android:strokeWidth="2.4"
        android:pathData="M68.1,73.4 L31.2,46.6" />

    <!-- Nœuds (cercles pleins, couleur = protocole dominant). -->
    <path android:fillColor="#4C9BE8"
        android:pathData="M54,25 a5,5 0 1,0 0.01,0 z" />
    <path android:fillColor="#1ABC9C"
        android:pathData="M76.8,41.6 a5,5 0 1,0 0.01,0 z" />
    <path android:fillColor="#27AE60"
        android:pathData="M68.1,68.4 a5,5 0 1,0 0.01,0 z" />
    <path android:fillColor="#F39C12"
        android:pathData="M39.9,68.4 a5,5 0 1,0 0.01,0 z" />
    <path android:fillColor="#E74C3C"
        android:pathData="M31.2,41.6 a5,5 0 1,0 0.01,0 z" />
</vector>
